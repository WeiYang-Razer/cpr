{
  "name": "cpr",
  "version": "1.15.1.0",
  "schemaVersion": 2,
  "kind": "StaticLib",
  "description": "C++ Requests - friendly wrapper around libcurl",
  "dependencies": {
    "curl": "^8.23.0.0"
  },
  "build": {
    "system": "cmake",
    "configs": [
      "Debug",
      "Release",
      "RelWithDebInfo",
      "MinSizeRel"
    ],
    "configure": [
      "-DCPR_BUILD_TESTS=OFF",
      "-DCPR_USE_SYSTEM_CURL=ON",
      "-DCPR_ENABLE_SSL=ON",
      "-DCPR_FORCE_WINSSL_BACKEND=ON",
      "-DCMAKE_DEBUG_POSTFIX=d",
      "-DCMAKE_RELWITHDEBINFO_POSTFIX=rd",
      "-DCMAKE_MINSIZEREL_POSTFIX=msr"
    ],
    "installDir": "install"
  }
}
